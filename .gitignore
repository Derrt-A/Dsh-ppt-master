# Dependencies
node_modules/

# Machine-local configuration (data root, local overrides)
config.local.json
config.*.local.json

# Secrets — never commit API keys, tokens or a generated settings.json
.env
.env.local
.env.*.local
settings.json
*.pem
*.key

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime data (never commit generated decks or engine copies)
*.pptx
*.pdf
*.log
tmp/
out/
